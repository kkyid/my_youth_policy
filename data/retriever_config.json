      "active": true,
      "weight": 0.7,
      "lambda_mult": 0.5,
      "score_threshold": 0.5
    },
    {
      "type": "미설정",
      "k": 5,
      "search_type": "미설정",
      "active": false,
      "weight": 1.0,
      "lambda_mult": 0.5,
      "score_threshold": 0.5
    }
  ],
  "reranker": {
    "enabled": false,
    "type": "Cross-Encoder",
    "model": "bongsoo/kpf-cross-encoder-v1",
    "final_k": 3
